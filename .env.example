# EcoTrack frontend environment
#
# The frontend reads no environment variables today: there is no backend yet,
# and the public enquiry form is configured in src/features/public/site/config.ts.
# See docs/BACKEND_HANDOFF.md.
#
# When the API is connected, add its base URL here, for example:
# VITE_API_BASE_URL=https://api.example.org
#
# Anything prefixed VITE_ is compiled into the public JavaScript bundle and can
# be read by anyone. Never put secrets (keys, tokens, database URLs) in a VITE_
# variable; they belong on the server.
# Copy this file to .env.local for local values; .env and .env.* are git-ignored.
